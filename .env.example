# MediConnect Backend Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example:
# MONGODB_URI=mongodb+srv://admin:mypassword@cluster0.abcde.mongodb.net/mediconnect?retryWrites=true&w=majority
MONGODB_URI=

# Email Notification System (Optional SMTP - Gmail / Outlook / Mailtrap / SendGrid)
# If left blank, notifications are automatically logged to the terminal console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediConnect Health" <noreply@mediconnect.health>
