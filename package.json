{
  "name": "mediconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"vite\" \"node --watch server/index.js\"",
    "frontend": "vite",
    "backend": "node --watch server/index.js",
    "client": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
